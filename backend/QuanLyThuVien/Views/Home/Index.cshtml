@*
    Trang chủ được mount riêng bởi src/index.tsx, không qua registry data-react-component.
    View chuẩn bị JSON trong #book-data nhưng entry hiện chưa đọc nó và vẫn dùng sách mẫu.
    TODO: Cho entry đọc #book-data rồi truyền initialBooks khi nối dữ liệu từ HomeController.
    - Nếu Model null hoặc rỗng, React tự dùng dữ liệu mẫu.
*@
@model IEnumerable<QuanLyThuVien.Models.Book>?

@{
    ViewData["Title"] = "Tra Cứu & Chi Tiết Sách Thư Viện";

    var jsonOptions = new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    };
    // Thay "<" bằng \u003c để chuỗi JSON không thể đóng sớm thẻ <script> (chống XSS)
    var booksJson = Model is null
        ? "[]"
        : System.Text.Json.JsonSerializer.Serialize(Model, jsonOptions).Replace("<", "\\u003c");
}

<div id="book-catalog-root"></div>

<script id="book-data" type="application/json">@Html.Raw(booksJson)</script>

@section Scripts {
    @* Entry index.js mount #book-catalog-root; main.js do _ViteScripts nạp chỉ mount các phần tử data-react-component. *@
    <script type="module" src="~/dist/assets/index.js" asp-append-version="true"></script>
}
