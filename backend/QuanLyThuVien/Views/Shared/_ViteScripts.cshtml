@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject Microsoft.Extensions.Configuration.IConfiguration Config

@{
    var devServerUrl = Config.GetValue<string>("Vite:ServerUrl", "http://localhost:5173");
    var isDevServerExplicit = Config.GetValue<bool?>("Vite:DevServer", null);
    var distJsPath = System.IO.Path.Combine(Env.WebRootPath, "dist", "assets", "main.js");
    var distIndexCssPath = System.IO.Path.Combine(Env.WebRootPath, "dist", "assets", "index.css");
    var distCssPath = System.IO.Path.Combine(Env.WebRootPath, "dist", "assets", "main.css");
    var hasDistBuild = System.IO.File.Exists(distJsPath);

    // true luôn chọn HMR trong Development; false luôn chọn bundle tĩnh.
    // Khi chưa cấu hình, chỉ chọn HMR nếu chưa có main.js. Ngoài Development luôn dùng bundle tĩnh.
    bool useDevServer = Env.IsDevelopment() && (isDevServerExplicit == true || (!hasDistBuild && isDevServerExplicit != false));
}

@if (useDevServer)
{
    @* Refresh preamble phải chạy trước entry React để plugin Vite nhận đúng môi trường HMR. *@
    <script type="module">
        import RefreshRuntime from '@devServerUrl/@@react-refresh'
        RefreshRuntime.injectIntoGlobalHook(window)
        window.$RefreshReg$ = () => {}
        window.$RefreshSig$ = () => () => {}
        window.__vite_plugin_react_preamble_installed__ = true
    </script>
    <script type="module" src="@devServerUrl/@@vite/client"></script>
    <script type="module" src="@devServerUrl/src/main.tsx"></script>
}
else
{
    @* Nạp cả index.css vì CSS dùng chung có thể được Vite tách từ hai entry main/index. *@
    @if (System.IO.File.Exists(distIndexCssPath))
    {
        <link rel="stylesheet" href="~/dist/assets/index.css" asp-append-version="true" />
    }
    @if (System.IO.File.Exists(distCssPath))
    {
        <link rel="stylesheet" href="~/dist/assets/main.css" asp-append-version="true" />
    }
    @if (hasDistBuild)
    {
        <script type="module" src="~/dist/assets/main.js" asp-append-version="true"></script>
    }
}
