@{
    ViewData["Title"] = "Thống kê & Báo cáo";
    var activeTab = ViewData["ActiveTab"]?.ToString();
    var tabs = new[] {
        (Key: "overview", Label: "Tổng quan"),
        (Key: "circulation", Label: "Mượn trả"),
        (Key: "overdue", Label: "Sách quá hạn"),
        (Key: "fines", Label: "Tiền phạt")
    };
}
<section class="library-page" aria-labelledby="page-title">
    <h1 id="page-title">@ViewData["Title"]</h1>
    <nav class="library-page-tabs" aria-label="Thống kê và báo cáo">
        @foreach (var tab in tabs)
        {
            <a asp-controller="Admin" asp-action="Reports" asp-route-tab="@tab.Key"
               aria-current="@(activeTab == tab.Key ? "page" : null)">@tab.Label</a>
        }
    </nav>
    <div class="library-page-body" data-active-tab="@activeTab">
        @* TODO: Tổng quan, báo cáo theo kỳ và xuất Excel/PDF. *@
    </div>
</section>
