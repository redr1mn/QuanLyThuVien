@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment
@{
    // Guest mở trực tiếp trang khung được xem sidebar trong Development; không áp dụng ngoại lệ này cho dữ liệu/API.
    var preview = Environment.IsDevelopment() && User.Identity?.IsAuthenticated != true;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var links = new[] {
        (Controller: "Staff", Action: "Books", Label: "Quản lý sách"),
        (Controller: "Staff", Action: "Readers", Label: "Quản lý độc giả & Thẻ"),
        (Controller: "Staff", Action: "Circulation", Label: "Mượn trả sách"),
        (Controller: "Admin", Action: "Reports", Label: "Thống kê & Báo cáo"),
        (Controller: "Admin", Action: "Users", Label: "Nhân viên & Phân quyền"),
        (Controller: "Admin", Action: "Settings", Label: "Cấu hình hệ thống")
    };
}
<nav class="library-workspace-links" aria-label="Chức năng quản lý">
    @foreach (var link in links)
    {
        var allowed = link.Controller == "Admin"
            ? User.IsInRole("Admin")
            : User.IsInRole("Admin") || User.IsInRole("Staff");
        if (!preview && !allowed)
        {
            continue;
        }
        <a asp-controller="@link.Controller" asp-action="@link.Action"
           aria-current="@(currentController == link.Controller && currentAction == link.Action ? "page" : null)">@link.Label</a>
    }
</nav>
