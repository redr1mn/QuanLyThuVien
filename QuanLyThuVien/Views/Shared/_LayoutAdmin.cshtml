@{
    Layout = "_Layout";
}
<div class="library-workspace">
    <aside class="library-workspace-sidebar" aria-label="Điều hướng quản lý">
        <partial name="_WorkspaceNavigation" />
    </aside>
    <div class="library-workspace-content">
        @RenderBody()
    </div>
</div>
@section Head {
    @await RenderSectionAsync("Head", required: false)
}
@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
