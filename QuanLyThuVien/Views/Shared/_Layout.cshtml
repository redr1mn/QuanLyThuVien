@{
    var isCatalog = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase);
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isLogin = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Account", StringComparison.OrdinalIgnoreCase)
        && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Login", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#F4F1EA" />
    <title>@ViewData["Title"] - Thư viện</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=IBM+Plex+Mono:wght@400;500;700&family=Inter:wght@400;500;600&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/library-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyThuVien.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="library-shell">
    <header class="library-header">
        <nav class="library-masthead navbar navbar-expand-lg" aria-label="Điều hướng chính">
            <a class="library-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Thư viện — Trang chủ">
                <svg class="library-mark" viewBox="0 0 44 48" fill="none" aria-hidden="true" focusable="false">
                    <path d="M6 5h10v38H6zM20 5h6v38h-6zM29 7l5-1 6 36-5 1z" stroke="currentColor" stroke-width="1.5" />
                    <path d="M8 12h6M8 35h6M22 12h2M22 35h2" stroke="currentColor" />
                </svg>
                <span class="library-name">Thư viện</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#library-navigation"
                    aria-controls="library-navigation" aria-expanded="false" aria-label="Mở hoặc đóng menu điều hướng">
                Menu
            </button>
            <div class="collapse navbar-collapse library-navigation" id="library-navigation">
                <div class="library-nav">
                    <a class="library-nav-link @(isCatalog ? "is-current" : "")"
                       asp-area="" asp-controller="Home" asp-action="Index"
                       aria-current="@(isCatalog ? "page" : null)">Trang chủ</a>
                    <partial name="_PrimaryNavigation" />
                </div>
            </div>
                <div class="library-account">
                    @if (isAuthenticated)
                    {
                        <div class="dropdown">
                            <button class="library-account-button dropdown-toggle" type="button" id="library-account-menu"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                @(User.Identity?.Name ?? "Tài khoản")
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="library-account-menu">
                                <li>
                                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                        <button class="dropdown-item" type="submit">Đăng xuất</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="library-login" asp-area="" asp-controller="Account" asp-action="Login"
                           aria-current="@(isLogin ? "page" : null)">Đăng nhập</a>
                    }
                </div>
        </nav>
    </header>

    <main id="main-content" class="library-content" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="library-footer">
        <div class="library-information">
            <section id="library-about" tabindex="-1" aria-labelledby="library-about-title">
                <h2 id="library-about-title">Giới thiệu</h2>
                <p>Tra cứu sách theo tên, tác giả hoặc ISBN. Độc giả có thể theo dõi thẻ thư viện và lịch sử mượn trả sau khi đăng nhập.</p>
            </section>
            <section id="library-rules" tabindex="-1" aria-labelledby="library-rules-title">
                <h2 id="library-rules-title">Nội quy thư viện</h2>
                <p>Sử dụng thẻ thư viện còn hiệu lực khi mượn sách. Giữ gìn sách và trả đúng hạn ghi trên phiếu mượn. Liên hệ thủ thư để được hướng dẫn về gia hạn thẻ, sách quá hạn hoặc hư hỏng.</p>
            </section>
        </div>
        <div class="library-colophon">
            <span>&copy; @DateTime.Now.Year Thư viện</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Quyền riêng tư</a>
            <a href="#main-content">Về đầu nội dung</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ViteScripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
