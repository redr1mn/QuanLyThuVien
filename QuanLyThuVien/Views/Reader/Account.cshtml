@{
    ViewData["Title"] = "Tài khoản độc giả";
    var activeTab = ViewData["ActiveTab"]?.ToString();
    var tabs = new[] {
        (Key: "profile", Label: "Thông tin cá nhân & Thẻ"),
        (Key: "loans", Label: "Sách đang mượn"),
        (Key: "history", Label: "Lịch sử đã trả & Tiền phạt"),
        (Key: "reservations", Label: "Sách đặt trước")
    };
}
<section class="library-page" aria-labelledby="page-title">
    <h1 id="page-title">@ViewData["Title"]</h1>
    <nav class="library-page-tabs" aria-label="Tài khoản độc giả">
        @foreach (var tab in tabs)
        {
            <a asp-controller="Reader" asp-action="Account" asp-route-tab="@tab.Key"
               aria-current="@(activeTab == tab.Key ? "page" : null)">@tab.Label</a>
        }
    </nav>
    <div class="library-page-body" data-active-tab="@activeTab">
        @* TODO: Nội dung của tab đang chọn; phân quyền trước khi tải dữ liệu cá nhân. *@
    </div>
</section>
