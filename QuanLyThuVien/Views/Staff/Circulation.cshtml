@{
    ViewData["Title"] = "Mượn trả sách";
    var activeTab = ViewData["ActiveTab"]?.ToString();
    var tabs = new[] {
        (Key: "list", Label: "Phiếu mượn & Quá hạn"),
        (Key: "borrow", Label: "Lập phiếu mượn"),
        (Key: "return", Label: "Trả sách & Thu phạt")
    };
}
<section class="library-page" aria-labelledby="page-title">
    <h1 id="page-title">@ViewData["Title"]</h1>
    <nav class="library-page-tabs" aria-label="Mượn trả sách">
        @foreach (var tab in tabs)
        {
            if (tab.Key != "list" && User.IsInRole("Admin") && !User.IsInRole("Staff"))
            {
                continue;
            }
            <a asp-controller="Staff" asp-action="Circulation" asp-route-tab="@tab.Key"
               aria-current="@(activeTab == tab.Key ? "page" : null)">@tab.Label</a>
        }
    </nav>
    <div class="library-page-body" data-active-tab="@activeTab">
        @* TODO: Nội dung tab. Chỉ Staff được lập phiếu mượn và xử lý trả sách; kiểm tra quyền ở backend. *@
    </div>
</section>
